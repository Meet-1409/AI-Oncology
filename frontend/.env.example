# Copy to .env.local and adjust. Never commit .env.local.
#
# The frontend communicates with the backend only through APIs [02 §9] and holds
# no secrets. Anything here is visible in the browser bundle, so it must never
# contain credentials, tokens or keys.

# Base URL of the backend API. Leave empty to use the in-memory mock adapter
# during frontend development, before the backend exists.
VITE_API_BASE_URL=

# Which data adapter to use: "mock" | "http"
VITE_DATA_ADAPTER=mock
